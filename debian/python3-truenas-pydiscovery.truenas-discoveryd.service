[Unit]
Description=TrueNAS Discovery Daemon (mDNS + NetBIOS NS + WS-Discovery)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify-reload
# systemd applies the start timeout to every reload as well; a reload
# requested during startup also waits for startup to finish.
TimeoutStartSec=300
User=truenas-discovery
Group=daemon
ExecStart=/usr/bin/truenas-discoveryd -c /etc/truenas-discovery/truenas-discoveryd.conf
RuntimeDirectory=truenas-discovery
RuntimeDirectoryMode=0755
ConfigurationDirectory=truenas-discovery
Restart=on-failure
RestartForceExitStatus=SIGHUP
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
